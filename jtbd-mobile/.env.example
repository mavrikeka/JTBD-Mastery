# Mobile App Configuration
#
# Note: Expo doesn't use .env files directly in the traditional way.
# Instead, configure the API URL in app.json under "extra.apiBaseUrl"
#
# For production:
# "apiBaseUrl": "https://your-production-api.com"
#
# For local development:
# "apiBaseUrl": "http://YOUR-LOCAL-IP:5001"
# (Get your IP with: ifconfig | grep "inet " on macOS/Linux)
